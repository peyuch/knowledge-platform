# PostgreSQL (DATABASE_URL uses asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/knowledge_platform
# sync URL for Alembic
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/knowledge_platform

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledge-platform
MINIO_SECURE=false

# RabbitMQ
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CHUNKS=knowledge.ingestion.chunks

# Redis
REDIS_URL=redis://localhost:6379/0

# MinerU
MINERU_API_URL=http://localhost:8001

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# App
APP_ENV=development
LOG_LEVEL=INFO

# LLM API (DeepSeek primary, Qwen backup)
GRAPHRAG_LLM_API_URL=https://api.deepseek.com
GRAPHRAG_LLM_API_KEY=your-deepseek-api-key
GRAPHRAG_LLM_MODEL=deepseek-chat
GRAPHRAG_BACKUP_LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode
GRAPHRAG_BACKUP_LLM_API_KEY=your-qwen-api-key
GRAPHRAG_BACKUP_LLM_MODEL=qwen-turbo

# RAPTOR LLM (可以复用 GraphRAG 的, 也可以独立配置)
RAPTOR_LLM_API_URL=https://api.deepseek.com
RAPTOR_LLM_API_KEY=your-deepseek-api-key
RAPTOR_LLM_MODEL=deepseek-chat
RAPTOR_BACKUP_LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode
RAPTOR_BACKUP_LLM_API_KEY=your-qwen-api-key
RAPTOR_BACKUP_LLM_MODEL=qwen-turbo
